# Copy to .env and fill in. NEVER commit .env.

# --- Azure AI Document Intelligence (required) ---
AZURE_DOCINTEL_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=

# --- Analysis ---
# prebuilt-read is the OCR model (text, pages, lines).
AZURE_DOCINTEL_MODEL_ID=prebuilt-read
ANALYSIS_TIMEOUT_SECONDS=120
MAX_CONCURRENT_ANALYSES=4

# --- Input limits ---
# Maximum decoded document size (also applied to URL downloads).
# Azure free tier (F0) accepts at most 4 MB; paid tiers accept far more.
MAX_FILE_SIZE_MB=20

# --- URL fetching ---
# Optional comma-separated domain allowlist (suffix match, e.g. blob.core.windows.net).
# Empty = any public HTTPS host (private/loopback/link-local addresses are always blocked).
URL_ALLOWED_DOMAINS=
URL_FETCH_TIMEOUT_SECONDS=30
URL_MAX_REDIRECTS=3

# --- Server ---
# Transport: streamable-http (default) | sse (legacy; endpoints /sse + /messages/) | stdio (local subprocess)
MCP_TRANSPORT=streamable-http
MCP_SSE_PATH=/sse
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
LOG_LEVEL=INFO

# Bearer token clients must send (Authorization: Bearer <token>).
# REQUIRED when MCP_HOST is not loopback. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
# Required when binding to a non-loopback host (DNS-rebinding protection). Comma-separated.
# e.g. ocr.example.com,ocr.example.com:443
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
